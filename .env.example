# muster-clankmail configuration. Placeholders only: copy to .env and fill in.
# Never commit a real token, key or hostname.

# muster's base URL, where /plugin/v1/* is served.
MUSTER_URL=http://muster.example.com:8105
# A file holding the mpl_ plugin token minted on muster's /plugins page.
PLUGIN_TOKEN_FILE=/cm/secrets/plugin.token
# The chief's ClankMail key file (`muster-clankmail keygen --out FILE`).
CHIEF_KEY_FILE=/cm/secrets/chief.key
# The ClankMail hub's base URL and its exact DNS name.
HUB_URL=https://hub.example.com
HUB_NAME=hub.example.com
# Pinned peers: <owner>/<name>=k_..., comma-separated. Empty until you pair.
CLANKMAIL_PEERS=
# A writable, persistent directory (state.json, state.lock, admin.sock).
STATE_DIR=/cm/state
# Optional.
POLL_INTERVAL=15s
LISTEN_ADDR=:8080
